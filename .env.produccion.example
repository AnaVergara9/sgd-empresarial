# ============================================================
# Plantilla del archivo .env para el servidor en la nube.
# En el servidor se copia como .env y se llenan los valores.
# El .env real NUNCA se sube a GitHub (ya está en .gitignore).
# ============================================================

# Dominio del proyecto (sin https:// y sin www)
DOMINIO=sgdempresarial.qd.je

# Dirección donde quedó publicado mf-navegacion en el hosting
# (con https:// y sin / al final)
URL_HOSTING_NAVEGACION=https://direccion-del-hosting

# Firebase (solo se usa para el inicio de sesión con Google)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (archivos del chat)
VITE_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=chat_upload
