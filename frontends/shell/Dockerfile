FROM node:22-alpine AS build
WORKDIR /app/shell
COPY shell/package*.json ./
RUN npm ci
COPY shell/ ./
# Tailwind del shell necesita ver las clases de los microfrontends
COPY mf-navegacion/src /app/mf-navegacion/src
COPY mf-chat/src /app/mf-chat/src

ARG VITE_API_URL
ARG VITE_MF_NAVEGACION_URL
ARG VITE_MF_CHAT_URL
ARG VITE_FIREBASE_API_KEY
ARG VITE_FIREBASE_AUTH_DOMAIN
ARG VITE_FIREBASE_PROJECT_ID
ARG VITE_FIREBASE_STORAGE_BUCKET
ARG VITE_FIREBASE_MESSAGING_SENDER_ID
ARG VITE_FIREBASE_APP_ID
ENV VITE_API_URL=$VITE_API_URL \
    VITE_MF_NAVEGACION_URL=$VITE_MF_NAVEGACION_URL \
    VITE_MF_CHAT_URL=$VITE_MF_CHAT_URL \
    VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY \
    VITE_FIREBASE_AUTH_DOMAIN=$VITE_FIREBASE_AUTH_DOMAIN \
    VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID \
    VITE_FIREBASE_STORAGE_BUCKET=$VITE_FIREBASE_STORAGE_BUCKET \
    VITE_FIREBASE_MESSAGING_SENDER_ID=$VITE_FIREBASE_MESSAGING_SENDER_ID \
    VITE_FIREBASE_APP_ID=$VITE_FIREBASE_APP_ID
RUN npm run build

FROM nginx:alpine
COPY shell/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/shell/dist /usr/share/nginx/html
EXPOSE 80