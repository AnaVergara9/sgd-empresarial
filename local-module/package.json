{
  "name": "@sgd/local-module",
  "version": "1.0.0",
  "private": true,
  "description": "Módulo local: Google Drive (index.js) y uso sin conexión con IndexedDB (src/)",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./sin-conexion": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ."
  }
}
